<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-name="s_budget_construction.BudgetItemListController" t-inherit="web.ListView"
        t-inherit-mode="primary">
        <xpath expr="//Layout" position="attributes">
            <attribute name="className">(model.useSampleModel ? 'o_view_sample_data ' : '') + 'o_budget_content'</attribute>
        </xpath>


        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-create-button">
                <t t-call="s_budget_construction.BudgetViews.ControlPanel" />
            </t>
        </xpath>


    </t>
</templates>