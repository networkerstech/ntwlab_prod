<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <div t-name="s_budget_construction.BudgetViews.ControlPanel"
        class="o_cp_buttons d-lg-flex gap-1"
        role="toolbar"
        aria-label="Control panel buttons"
        t-ref="cpButtons">
            <button type="button"
                class="btn btn-primary"
                t-on-click.stop.prevent="onClickCreateGrouper"
                data-hotkey="g">
                Grouper <i class="fa fa-plus" aria-hidden="true"></i>
            </button>

            <button type="button"
                class="btn btn-primary"
                t-on-click.stop.prevent="onClickCreateConcept"
                data-hotkey="c">
                Concept <i class="fa fa-plus" aria-hidden="true"></i>
            </button>
    </div>
</templates>