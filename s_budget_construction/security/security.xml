<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_budget_construction">
            <field name="name">Construction budget</field>
            <field name="description">Manage construction budgets</field>
            <field name="sequence">7</field>
        </record>

        <record model="res.groups.privilege" id="privilege_budget_construction">
            <field name="name">Construction budget</field>
            <field name="category_id" ref="s_budget_construction.module_category_budget_construction" />
        </record>

        <record id="group_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id"
                ref="s_budget_construction.privilege_budget_construction" />
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        </record>

        <record id="group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id"
                ref="s_budget_construction.privilege_budget_construction" />
            <field name="implied_ids" eval="[(4, ref('s_budget_construction.group_user'))]" />
        </record>

        <record id="group_price_list_user" model="res.groups">
            <field name="name">Can Edit Budget Price List</field>
        </record>

        <record id="group_budget_template_user" model="res.groups">
            <field name="name">Can Edit Budget Template</field>
        </record>
    </data>
</odoo>