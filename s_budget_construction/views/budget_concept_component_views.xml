<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="budget_concept_component_view_tree" model="ir.ui.view">
        <field name="name">s.budget.const.concept.component.view.tree</field>
        <field name="model">s.budget.const.concept.component</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="1">
                <field name="supply_code" />
                <field name="supply_id" />
                <field name="price_list_id" column_invisible="1"/>
                <field name="supply_type" />
                <field name="description" />
                <field name="uom_id" />
                <field name="price_unit" />
                <field name="quantity" />
                <field name="price_total" />

                <button
                    type="object"
                    name="action_open_component_form"
                    title="Open"
                    class="btn btn-link"
                    icon="fa-share-square-o"
                />
            </list>
        </field>
    </record>
    <record id="budget_concept_component_view_form" model="ir.ui.view">
        <field name="name">s.budget.const.concept.component.view.form</field>
        <field name="model">s.budget.const.concept.component</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group name="main">
                        <field name="id" invisible="1" />
                        <group>
                            <field name="project_id" />
                            <field name="supply_code" />
                            <field name="supply_code_aux" />
                            <field name="supply_id"  force_save="1"/>
                            <field name="price_list_id" invisible="1" />
                            <field name="pricelist_line_id" readonly="1" />
                            <field name="description" />
                        </group>
                        <group>
                            <field name="product_template_id" />
                            <field name="uom_id" />
                            <field name="price_unit" />
                            <field name="quantity" />
                        </group>
                        <field name="price_total" />
                        <field name="supply_type" invisible="1"/>
                    </group>
                    <notebook invisible="supply_type not in ['auxiliaries']">
                        <page name="all_componets" string="All">
                            <field name="component_ids" context="{'is_all': True}" >
                                <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                     <button type="object" name="action_open_component_form" invisible="supply_type != 'auxiliaries'" title="Open" class="btn btn-link" icon="fa-share-square-o"/>
                                </list>
                            </field>
                        </page>
                        <page name="material_componets" string="Materials">
                            <field name="component_material_ids"  context="{'is_material': True, 'default_supply_type': 'material'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux" context="{'is_material': True}"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="work_force_components" string="Work force">
                            <field name="component_work_force_ids" context="{'is_work_force': True, 'default_supply_type': 'work_force'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="budget_gang_id" />
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="tool_componets" string="Tools">
                            <field name="component_tools_ids" context="{'is_tools': True, 'default_supply_type': 'tools'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="machinery_componets" string="Machinery">
                            <field name="component_machinery_ids" context="{'is_machinery': True, 'default_supply_type': 'machinery'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="auxiliaries_componets" string="Auxiliaries">
                            <field name="component_auxiliaries_ids" context="{'form_view_ref': 's_budget_construction.budget_concept_component_view_form','is_aux': True, 'default_supply_type': 'auxiliaries'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                    <field name="component_ids" force_save="1">
                                        <list editable="bottom">
                                            <field name="supply_code_aux" force_save="1"/>
                                            <field name="product_template_id" force_save="1"/>
                                            <field name="budget_gang_id" force_save="1"/>
                                            <field name="supply_id" force_save="1"/>
                                            <field name="supply_type" force_save="1"/>
                                            <field name="description" force_save="1"/>
                                            <field name="quantity" force_save="1"/>
                                            <field name="uom_id" force_save="1"/>
                                            <field name="price_unit" force_save="1"/>
                                            <field name="price_total" force_save="1"/>
                                        </list>
                                    </field>
                                    <button type="object" name="action_open_component_form" invisible="supply_type != 'auxiliaries'" title="Open" class="btn btn-link" icon="fa-share-square-o"/>
                                </list>
                            </field>
                        </page><group name="main">
                        <field name="id" invisible="1" />
                        <group>
                            <field name="supply_code" />
                            <field name="supply_id"  force_save="1"/>
                            <field name="price_list_id" invisible="1" />
                            <field name="pricelist_line_id" readonly="1" />
                            <field name="description" />
                        </group>
                        <group>
                            <field name="uom_id" />
                            <field name="price_unit" />
                            <field name="quantity" />
                        </group>
                        <field name="price_total" />
                        <field name="supply_type" invisible="1"/>
                    </group>
                    <notebook invisible="supply_type not in ['auxiliaries']">
                        <page name="all_componets" string="All">
                            <field name="component_ids" context="{'is_all': True}" >
                                <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                     <button type="object" name="action_open_component_form" invisible="supply_type != 'auxiliaries'" title="Open" class="btn btn-link" icon="fa-share-square-o"/>
                                </list>
                            </field>
                        </page>
                        <page name="material_componets" string="Materials">
                            <field name="component_material_ids"  context="{'is_material': True, 'default_supply_type': 'material'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux" context="{'is_material': True}"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="work_force_components" string="Work force">
