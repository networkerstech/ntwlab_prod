                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="budget_gang_id" />
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="tool_componets" string="Tools">
                            <field name="component_tools_ids" context="{'is_tools': True, 'default_supply_type': 'tools'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="machinery_componets" string="Machinery">
                            <field name="component_machinery_ids" context="{'is_machinery': True, 'default_supply_type': 'machinery'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="auxiliaries_componets" string="Auxiliaries">
                            <field name="component_auxiliaries_ids" context="{'form_view_ref': 's_budget_construction.budget_concept_component_view_form','is_aux': True, 'default_supply_type': 'auxiliaries'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True)]"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                    <field name="component_ids" force_save="1">
                                        <list editable="bottom">
                                            <field name="supply_code_aux" force_save="1"/>
                                            <field name="product_template_id" force_save="1"/>
                                            <field name="budget_gang_id" force_save="1"/>
                                            <field name="supply_id" force_save="1"/>
                                            <field name="supply_type" force_save="1"/>
                                            <field name="description" force_save="1"/>
                                            <field name="quantity" force_save="1"/>
                                            <field name="uom_id" force_save="1"/>
                                            <field name="price_unit" force_save="1"/>
                                            <field name="price_total" force_save="1"/>
                                        </list>
                                    </field>
                                    <button type="object" name="action_open_component_form" invisible="supply_type != 'auxiliaries'" title="Open" class="btn btn-link" icon="fa-share-square-o"/>
                                </list>
                            </field>
                        </page>
                        <page name="transport_cost_componets" string="Transport cost">
                            <field name="component_transport_cost_ids" context="{'is_transport_cost': True, 'default_supply_type': 'transport_cost'}">
                                 <list editable="bottom">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="fleet_vehicle_id" />
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <page name="transport_cost_componets" string="Transport cost">
                        <field name="component_transport_cost_ids" context="{'is_transport_cost': True, 'default_supply_type': 'transport_cost'}">
                             <list editable="bottom">
                                <field name="supply_code_aux"/>
                                <field name="supply_id" force_save="1"/>
                                <field name="fleet_vehicle_id" />
                                <field name="supply_type"/>
                                <field name="description"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                                <field name="price_unit"/>
                                <field name="price_total"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                </sheet>
                <footer>
                    <button name="action_save_and_stay" type="object" string="Save and Continue" class="btn-primary" />
                    <button name="action_close_and_open_new_wizard" type="object" string="Save and Close" class="btn-secondary" />
                    <button string="Cancelar" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="budget_concept_component_action" model="ir.actions.act_window">
        <field name="name">Concept Components</field>
        <field name="res_model">s.budget.const.concept.component</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_s_budget_const_concept_component" model="ir.actions.act_window">
        <field name="name">Auxiliars</field>
        <field name="res_model">s.budget.const.concept.component</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_supply_type':'auxiliaries'}</field>
        <field name="domain">[('supply_type', 'in', ['auxiliaries'])]</field>
    </record>
</odoo>