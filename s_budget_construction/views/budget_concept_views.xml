<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- CONCEPT -->
        <record id="budget_concept_view_list" model="ir.ui.view">
            <field name="model">s.budget.const.concept</field>
            <field name="name">s.budget.const.concept.view.list</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code" />
                    <field name="name" />
                    <field name="project_id" />
                    <field name="uom_id" />
                    <field name="price_unit" />
                </list>
            </field>
        </record>

        <record id="budget_concept_view_form" model="ir.ui.view">
            <field name="name">s.budget.const.item.view.form</field>
            <field name="model">s.budget.const.concept</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="id" invisible="1" />
                    </group>
                    <group name="main">
                        <group>
                            <field name="code" />
                            <field name="name" />
                            <field name="project_id" />
                            <field name="is_a_buget_template" invisible="1"/>
                            <field name="concept_template_id" readonly="1" invisible="is_a_buget_template"/>
                        </group>
                        <group>
                            <field name="uom_id" />
                            <field name="price_list_id" invisible="1"/>
                            <field name="price_unit" />
                            <field name="price_unit_aux" invisible="1"/>
                        </group>
                        <field name="description" />
                    </group>
                    <div invisible="concept_template_id != False or is_a_buget_template" style="background-color: #ffc9c9;">In the system there is no template with this code, once you finish configuring this you can press the create template button to store it.</div>
                        <button name="set_template_element"
                            invisible="concept_template_id != False or is_a_buget_template"
                            string="Create Concept Template"
                            type="object"
                            class="btn-primary"/>
                    
                    <notebook>
                        <page name="all_componets" string="All">
                            <field name="component_ids" context="{'is_all': True}">
                                <list editable="bottom" context="{'is_all': True}">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id"/>
                                    <field name="pricelist_line_id" optional="hide"/>
                                    <field name="budget_gang_id" column_invisible="1"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/> <button type="object" name="action_open_component_form" invisible="supply_type != 'auxiliaries'" title="Open" class="btn btn-link" icon="fa-share-square-o"/>
                                </list>
                            </field>
                        </page>
                        <page name="material_componets" string="Materials">
                            <field name="component_material_ids" context="{'is_material': True, 'default_supply_type': 'material'}">
                                 <list editable="bottom" context="{'is_material': True, 'default_supply_type': 'material'}">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True), ('supply_type', '=', 'material')]"/>
                                     <field name="price_list_id" optional="hide"/>
                                     <field name="pricelist_line_id" optional="hide"/>
                                    <field name="budget_gang_id" column_invisible="1"/>
                                    <field name="supply_type"  readonly="1" force_save="1"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="work_force_components" string="Work force">
                            <field name="component_work_force_ids" context="{'is_work_force': True, 'default_supply_type': 'work_force'}">
                                <list editable="bottom" context="{'is_work_force': True, 'default_supply_type': 'work_force'}">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id"  column_invisible="1" force_save="1"/>
                                    <field name="budget_gang_id" domain="[('build_ok', '=', True), ('supply_type', '=', 'work_force')]"/>
                                    <field name="product_template_id" column_invisible="1"/>
                                    <field name="supply_type" readonly="1" force_save="1"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="tool_componets" string="Tools">
                            <field name="component_tools_ids" context="{'is_tools': True, 'default_supply_type': 'tools'}">
                                 <list editable="bottom" context="{'is_tools': True, 'default_supply_type': 'tools'}">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id"  column_invisible="1" force_save="1"/>
                                    <field name="product_template_id" domain="[('build_ok', '=', True), ('supply_type', '=', 'tools')]"/>
                                    <field name="budget_gang_id" column_invisible="1"/>
                                    <field name="supply_type" readonly="1" force_save="1"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="machinery_componets" string="Machinery">
                            <field name="component_machinery_ids" context="{'is_machinery': True, 'default_supply_type': 'machinery'}">
                                <list editable="bottom" context="{'is_machinery': True, 'default_supply_type': 'machinery'}">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id"  column_invisible="1" force_save="1"/>
                                    <field name="product_template_id" domain="[('machinery_ok', '=', True), ('supply_type', '=', 'machinery')]"/>
                                    <field name="budget_gang_id" column_invisible="1"/>
                                    <field name="supply_type" readonly="1" force_save="1"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                        <page name="auxiliaries_componets" string="Auxiliaries">
                            <field name="component_auxiliaries_ids" context="{'form_view_ref': 's_budget_construction.budget_concept_component_view_form','is_aux': True, 'default_supply_type': 'auxiliaries'}">
                                <list editable="bottom" context="{'is_aux': True, 'default_supply_type': 'auxiliaries'}">
                                    <field name="supply_code_aux" context="{'is_aux': True}"/>
                                    <field name="supply_id"  domain="[('supply_type', '=', 'auxiliaries')]" force_save="1"/>
                                    <field name="supply_type"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                    <field name="component_ids" force_save="1">
                                        <list editable="bottom">
                                            <field name="supply_code_aux" force_save="1"/>
                                            <field name="product_template_id" force_save="1"/>
                                            <field name="budget_gang_id" force_save="1"/>
                                            <field name="supply_id" force_save="1"/>
                                            <field name="supply_type" force_save="1"/>
                                            <field name="description" force_save="1"/>
                                            <field name="quantity" force_save="1"/>
                                            <field name="uom_id" force_save="1"/>
                                            <field name="price_unit" force_save="1"/>
                                            <field name="price_total" force_save="1"/>
                                        </list>
                                    </field>
                                    <button type="object" name="action_open_component_form" title="Open" class="btn btn-link" invisible="supply_type != 'auxiliaries'" icon="fa-share-square-o"/>
                                </list>
                            </field>
                        </page>
                        <page name="transport_cost_componets" string="Transport cost">
                            <field name="component_transport_cost_ids" context="{'is_transport_cost': True, 'default_supply_type': 'transport_cost'}">
                                 <list editable="bottom" context="{'is_transport_cost': True, 'default_supply_type': 'transport_cost'}">
                                    <field name="supply_code_aux"/>
                                    <field name="supply_id" column_invisible="1" force_save="1"/>
                                    <field name="fleet_vehicle_id" domain="[('build_ok', '=', True), ('supply_type', '=', 'transport_cost')]"/>
                                    <field name="supply_type" readonly="1" force_save="1"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="price_unit"/>
                                    <field name="price_total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button name="action_save_and_stay" type="object" string="Save and Continue" class="btn-primary" />
                        <button string="Cancelar" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="budget_concept_action" model="ir.actions.act_window">
            <field name="name">Concepts</field>
            <field name="res_model">s.budget.const.concept</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>