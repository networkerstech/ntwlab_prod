<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Lista -->
        <record id="view_budget_gang_tree" model="ir.ui.view">
            <field name="name">budget.gang.tre</field>
            <field name="model">budget.gang</field>
            <field name="arch" type="xml">
                <list string="Gang">
                    <field name="internal_reference"/>
                    <field name="name"/>
                    <field name="cost_type"/>
                    <field name="total_cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="currency_id" column_invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Vista Formulario -->
        <record id="view_budget_gang_form" model="ir.ui.view">
            <field name="name">budget.gang.form</field>
            <field name="model">budget.gang</field>
            <field name="arch" type="xml">
                <form string="Gang">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="cost_type" style="width: 20% !important;"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="build_ok" />
                                <field name="supply_type" invisible="not build_ok"/>
                                <field name="category_id"/>
                                <field name="internal_reference"/>
                            </group>
                        </group>
                        <separator string="Employees" />
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom" no_open="true">
                                    <field name="employee_id" required="1"/>
                                    <field name="quantity"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="hourly_cost"  column_invisible="parent.cost_type != 'hour'" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="daily_cost"  column_invisible="parent.cost_type != 'day'" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="weekly_cost" column_invisible="parent.cost_type != 'week'"  widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="monthly_cost" column_invisible="parent.cost_type != 'month'"  widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <field name="total_cost" sum="Total" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                </list>
                            </field>
                        <group>
                            <label for="brigade_chief_id" string="Brigade Chief"/>
                            <div class="oe_inline">
                                <field name="brigade_chief_id" class="oe_inline"/>
                                <field name="percentage" class="oe_inline"/> %
                            </div>
                        </group>
                        <group>
                            <field name="total_cost" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Acción -->
        <record id="action_budget_gang" model="ir.actions.act_window">
            <field name="name">Cuadrillas</field>
            <field name="res_model">budget.gang</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p>
                    Crea y gestiona las cuadrillas, asigna empleados y calcula los costos totales.
                </p>
            </field>
        </record>

        <menuitem id="menu_gang" name="Cuadrillas"
            parent="hr.menu_hr_department_kanban"
            action="action_budget_gang"
            sequence="10"/>
        <menuitem id="menu_gang_budget" name="Cuadrillas"
            parent="s_budget_construction.product_menu"
            action="action_budget_gang"
            sequence="10"/>

    </data>
</odoo>